# Required to enable AI responses. Without a key, chat uses the built-in fallback flow.
AI_API_KEY=

# OpenAI-compatible chat-completions endpoint. A Cloudflare AI Gateway URL can be used here.
AI_API_URL=https://api.openai.com/v1/chat/completions

# Choose a model supported by the configured endpoint.
AI_MODEL=gpt-4.1-mini

# Optional Stripe link displayed only when the assistant determines checkout is appropriate.
STRIPE_CHECKOUT_URL=
