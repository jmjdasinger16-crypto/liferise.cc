{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liferise-form-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "liferise.cc/api/*",
      "zone_name": "liferise.cc"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liferise-leads",
      "database_id": "b08d0369-11b4-457a-9704-687aa7daae71"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["support@liferise.cc"]
    }
  ]
}
